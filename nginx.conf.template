server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # SPA: cualquier ruta que no sea un archivo real cae en index.html para que el
    # router de Angular la resuelva en el cliente.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # El frontend en producción habla con /api (ver environment.ts); nginx reenvía al
    # backend, evitando que el navegador tenga que lidiar con CORS (la llamada real
    # cruza orígenes servidor-a-servidor, no desde el browser).
    #
    # BACKEND_URL se resuelve en el arranque del contenedor (envsubst sobre este
    # template, ver Dockerfile) — por defecto apunta al nombre de servicio de Docker
    # Compose (http://backend:8080), pero en un despliegue donde front y back son dos
    # apps separadas (Dokploy, etc.) se pisa con la URL real del backend.
    resolver 127.0.0.11 valid=10s;

    location /api/ {
        set $backend_upstream ${BACKEND_URL};
        # $request_uri (no $uri): la URI original completa tal como llegó del cliente,
        # sin normalizar. Con una variable en proxy_pass, nginx NO hace el
        # location-prefix-stripping automático que sí hace con una cadena fija — un sufijo
        # fijo aquí (p. ej. "/api/") se usaría literal para TODAS las requests, perdiendo
        # el resto de la ruta real (bug real, encontrado probando de verdad).
        proxy_pass $backend_upstream$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~* \.(?:css|js|map|jpg|jpeg|png|gif|ico|svg|woff2?)$ {
        expires 30d;
        access_log off;
    }

    # mime.types de nginx no trae .webmanifest
    location = /site.webmanifest {
        default_type application/manifest+json;
        expires 7d;
        access_log off;
    }
}
